// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectEquipo.wo
// SelectEquipo
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Open liga
Open equipo

Object oSelectEquipo is a cWebView
    Set psCaption to "Equipos"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Set Main_DD to oequipo_DD
    Set Server  to oequipo_DD

    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to False
        Set piSortColumn to 0

        Object oequipoID is a cWebColumn
            Entry_Item equipo.ID
            Set psCaption to "ID"
            Set piWidth to 80
        End_Object 

        Object oequipoNombre is a cWebColumn
            Entry_Item equipo.Nombre
            Set psCaption to "Nombre"
            Set piWidth to 500
        End_Object 

        Object oligaNombre is a cWebColumn
            Entry_Item liga.Nombre
            Set psCaption to "Liga"
            Set piWidth to 300
        End_Object 

        // Boton 1: Editar / Detalle de Equipo
        Object oZoomButton is a cWebColumnButton
            Set psCaption to "Editar"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Edit"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oZoomEquipo

            Procedure OnClick
                Send NavigateForward of oZoomEquipo Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                RowID riRowId

                Move False to NavigateData.bNewRecord
                Move False to NavigateData.bReadOnly

                // Obtencion y serializacion valida del RowID
                Move (GetRowId(equipo.File_Number)) to riRowId
                If (not(IsNullRowID(riRowId))) Begin
                    Move (SerializeRowID(riRowId)) to NavigateData.sRowId
                End

                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "EquipoID" to NavigateData.NamedValues[iElements].sName
                Move (String(equipo.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object

        // Boton 2: Ver Jugadores del equipo
        Object oJugadoresButton is a cWebColumnButton
            Set psCaption to "Jugadores"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_User"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oSelectJugador

            Procedure OnClick
                Send NavigateForward of oSelectJugador Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                Move True to NavigateData.bReadOnly

                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "EquipoID" to NavigateData.NamedValues[iElements].sName
                Move (String(equipo.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object

        // Boton 3: Ver Entrenador del equipo
        Object oEntrenadorButton is a cWebColumnButton
            Set psCaption to "Entrenador"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oSelectEntrenador

            Procedure OnClick
                Send NavigateForward of oSelectEntrenador Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                Move True to NavigateData.bReadOnly

                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "EquipoID" to NavigateData.NamedValues[iElements].sName
                Move (String(equipo.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object

        WebRegisterPath ntNavigateForward oZoomEquipo

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromChild)
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send NavigateClose Self
                    Case Break

                Case Else
                    Send NavigateForward of oZoomEquipo Self
            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Integer iElements
            RowID riRowId

            Move False to NavigateData.bNewRecord
            Move False to NavigateData.bReadOnly

            Move (GetRowId(equipo.File_Number)) to riRowId
            If (not(IsNullRowID(riRowId))) Begin
                Move (SerializeRowID(riRowId)) to NavigateData.sRowId
            End

            Move (SizeOfArray(NavigateData.NamedValues)) to iElements
            Move "EquipoID" to NavigateData.NamedValues[iElements].sName
            Move (String(equipo.ID)) to NavigateData.NamedValues[iElements].sValue
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure
        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            WebRegisterPath ntNavigateForward oZoomEquipo

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                Move True to NavigateData.bNewRecord
                Move False to NavigateData.bReadOnly
                
                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "LigaID" to NavigateData.NamedValues[iElements].sName
                Move (String(liga.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oZoomButton to True
        WebSet pbRender of oJugadoresButton to True
        WebSet pbRender of oEntrenadorButton to True
    End_Procedure

End_Object