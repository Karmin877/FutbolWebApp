// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugadorPosicion.wo
// ZoomJugadorPosicion
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Open liga
Open equipo
Open jugador
Open posicion
Open jugadorposicion

Object oZoomJugadorPosicion is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Asignar Posición"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    { WebProperty=Server }
    Property String psJugadorID ""

    { WebProperty=Server }
    Property String psPosicionID ""

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object 

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugador_DD
        Set DDO_Server to oposicion_DD

        Procedure Creating
            String sJugID sPosID
            Forward Send Creating
            
            WebGet psJugadorID of oZoomJugadorPosicion to sJugID
            If (jugador.ID <> 0) Begin
                Move jugador.ID to jugadorposicion.JugadorID
            End
            Else If (sJugID <> "") Begin
                Move (Integer(sJugID)) to jugadorposicion.JugadorID
            End

            WebGet psPosicionID of oZoomJugadorPosicion to sPosID
            If (posicion.ID <> 0) Begin
                Move posicion.ID to jugadorposicion.PosicionID
            End
            Else If (sPosID <> "") Begin
                Move (Integer(sPosID)) to jugadorposicion.PosicionID
            End
        End_Procedure
    End_Object 

    Set Main_DD to ojugadorposicion_DD
    Set Server  to ojugadorposicion_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object ojugadorposicionID is a cWebForm
            Entry_Item jugadorposicion.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
            Set pbReadOnly to True
        End_Object 

        // Campos ocultos para mantener la sincronizacion de claves foraneas en cliente
        Object ojugadorposicionJugadorID is a cWebForm
            Entry_Item jugadorposicion.JugadorID
            Set pbRender to False
        End_Object

        Object ojugadorposicionPosicionID is a cWebForm
            Entry_Item jugadorposicion.PosicionID
            Set pbRender to False
        End_Object

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 10
            Set piColumnIndex to 2
            Set peLabelPosition to lpTop
            Set psLabel to "Jugador"
            Set pbReadOnly to True
        End_Object 

        Object oposicionNombre is a cWebForm
            Entry_Item posicion.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Posición"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectPosicion

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object 

        Object oBtnEliminarDirecto is a cWebButton
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set psCaption to "DESVINCULAR ESTA POSICIÓN"
            Set psCSSClass to "WebButtonAlert"

            Procedure OnClick
                Send Request_Delete of oZoomJugadorPosicion
            End_Procedure
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adBoth

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord bIsNew
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord
        Move (NavigateData.bNewRecord) to bIsNew

        If (bIsNew) Begin
            Move False to bHasRecord
        End
        Else Begin
            If (jugadorposicion.ID <> 0) Move True to bHasRecord
        End

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to bHasRecord
        WebSet pbRender of oBtnEliminarDirecto to bHasRecord

        If (NavigateData.bReadOnly and not(bIsNew)) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateBack tWebNavigateData NavigateData Handle hoInvokingView
        String sJugID sPosID
        Integer iIndex iCount
        Forward Send OnNavigateBack NavigateData hoInvokingView

        // 1. Sincronizar jugador
        WebGet psJugadorID to sJugID
        If (sJugID <> "" and jugador.ID = 0) Begin
            Clear jugador
            Move (Integer(sJugID)) to jugador.ID
            Send Find of ojugador_DD EQ 1
            Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.JugadorID to (Integer(sJugID))
        End

        // 2. Extraer PosicionID devuelto en NamedValues
        Move (SizeOfArray(NavigateData.NamedValues)) to iCount
        For iIndex from 0 to (iCount - 1)
            If (NavigateData.NamedValues[iIndex].sName = "PosicionID") Begin
                Move NavigateData.NamedValues[iIndex].sValue to sPosID
            End
        Loop

        If (sPosID = "" and posicion.ID <> 0) Begin
            Move (String(posicion.ID)) to sPosID
        End

        // 3. Forzar carga en el DDO de posicion y en el buffer intermedio
        If (sPosID <> "" and sPosID <> "0") Begin
            WebSet psPosicionID to sPosID
            Clear posicion
            Move (Integer(sPosID)) to posicion.ID
            Send Find of oposicion_DD EQ 1

            Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.PosicionID to (Integer(sPosID))
        End

        Send SetActionButtons
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        RowID riJP
        Integer iIndex iCount
        String sJugadorID sJPID

        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject

        Move (SizeOfArray(NavigateData.NamedValues)) to iCount
        For iIndex from 0 to (iCount - 1)
            If (NavigateData.NamedValues[iIndex].sName = "JugadorID") Begin
                Move NavigateData.NamedValues[iIndex].sValue to sJugadorID
            End
            If (NavigateData.NamedValues[iIndex].sName = "JugadorPosicionID") Begin
                Move NavigateData.NamedValues[iIndex].sValue to sJPID
            End
        Loop

        If (sJugadorID <> "") Begin
            WebSet psJugadorID to sJugadorID
            Clear jugador
            Move (Integer(sJugadorID)) to jugador.ID
            Send Find of ojugador_DD EQ 1
        End

        If (NavigateData.bNewRecord) Begin
            Send Request_Clear of ojugadorposicion_DD
            If (sJugadorID <> "") Begin
                Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.JugadorID to (Integer(sJugadorID))
            End
            WebSet psPosicionID to ""
        End
        Else Begin
            If (NavigateData.sRowId <> "") Begin
                Move (DeserializeRowID(NavigateData.sRowId)) to riJP
                If (not(IsNullRowID(riJP))) Begin
                    Send FindByRowId of ojugadorposicion_DD jugadorposicion.File_Number riJP
                End
            End

            If (not(HasRecord(ojugadorposicion_DD)) and sJPID <> "" and sJPID <> "0") Begin
                Clear jugadorposicion
                Move (Integer(sJPID)) to jugadorposicion.ID
                Send Find of ojugadorposicion_DD EQ 1
            End

            If (HasRecord(ojugadorposicion_DD)) Begin
                WebSet psPosicionID to (String(jugadorposicion.PosicionID))
            End
        End

        Send SetActionButtons
    End_Procedure

    Procedure OnShow
        Forward Send OnShow
        Send SetActionButtons
    End_Procedure

End_Object