// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// ZoomJugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Open liga
Open equipo
Open jugador
Open posicion
Open jugadorposicion

Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Detalle Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    { WebProperty=Server }
    Property String psEquipoID ""

    // Servidores padre
    Object oliga_DD is a cligaDataDictionary
    End_Object

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object

    // DDO Principal
    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD

        Procedure Creating
            String sEqID
            Forward Send Creating
            
            WebGet psEquipoID of oZoomJugador to sEqID
            If (equipo.ID <> 0) Begin
                Move equipo.ID to jugador.EquipoID
            End
            Else If (sEqID <> "" and sEqID <> "0") Begin
                Move (Integer(sEqID)) to jugador.EquipoID
            End
        End_Procedure
    End_Object

    // Clientes requeridos para eliminacion en cascada (jugador -> jugadorposicion)
    Object oposicion_DD is a cposicionDataDictionary
    End_Object

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugador_DD
        Set DDO_Server to oposicion_DD
        Set Constrain_File to jugador.File_Number
    End_Object

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object ojugadorID is a cWebForm
            Entry_Item jugador.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
            Set pbReadOnly to True
        End_Object

        Object ojugadorEquipoID is a cWebForm
            Entry_Item jugador.EquipoID
            Set pbRender to False
        End_Object

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 5
            Set piColumnIndex to 2
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 5
            Set piColumnIndex to 7
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object

        Object oequipoNombre is a cWebForm
            Entry_Item equipo.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object

        // Boton directo en panel para gestionar posiciones del jugador
        Object oBtnVerPosiciones is a cWebButton
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set psCaption to "GESTIONAR POSICIONES DEL JUGADOR"
            Set psCSSClass to "WebButtonPrimary"

            WebRegisterPath ntNavigateForward oSelectJugadorPosicion

            Procedure OnClick
                Send NavigateForward of oSelectJugadorPosicion Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                Move True to NavigateData.bReadOnly

                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "JugadorID" to NavigateData.NamedValues[iElements].sName
                Move (String(jugador.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object

        // Boton directo visible en panel para eliminar
        Object oBtnEliminarDirecto is a cWebButton
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set psCaption to "ELIMINAR ESTE JUGADOR"
            Set psCSSClass to "WebButtonAlert"

            Procedure OnClick
                Send Request_Delete of oZoomJugador
            End_Procedure
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adBoth

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object

        Object oPosicionesBtn is a cWebMenuItem
            Set psCaption to "Posiciones"
            Set peActionDisplay to adBoth

            WebRegisterPath ntNavigateForward oSelectJugadorPosicion

            Procedure OnClick
                Send NavigateForward of oSelectJugadorPosicion Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Integer iElements
                Move True to NavigateData.bReadOnly

                Move (SizeOfArray(NavigateData.NamedValues)) to iElements
                Move "JugadorID" to NavigateData.NamedValues[iElements].sName
                Move (String(jugador.ID)) to NavigateData.NamedValues[iElements].sValue
            End_Procedure
        End_Object
    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord bIsNew
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord
        Move (NavigateData.bNewRecord) to bIsNew

        If (bIsNew) Begin
            Move False to bHasRecord
        End
        Else Begin
            If (jugador.ID <> 0) Move True to bHasRecord
        End

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to bHasRecord
        WebSet pbRender of oBtnEliminarDirecto to bHasRecord

        // Mostrar boton de posiciones solo si el jugador ya existe guardado
        WebSet pbRender of oBtnVerPosiciones to bHasRecord
        WebSet pbRender of oPosicionesBtn to bHasRecord

        If (NavigateData.bReadOnly and not(bIsNew)) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateBack tWebNavigateData NavigateData Handle hoInvokingView
        Forward Send OnNavigateBack NavigateData hoInvokingView

        If (equipo.ID <> 0) Begin
            Send Find of oequipo_DD EQ 1
            WebSet psEquipoID to (String(equipo.ID))
            Set Field_Changed_Value of ojugador_DD Field jugador.EquipoID to equipo.ID
        End
        Send SetActionButtons
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        RowID riJugador
        Integer iIndex iCount
        String sEquipoID sJugadorID

        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject

        If (NavigateData.bNewRecord) Begin
            Send Request_Clear of ojugador_DD

            Move (SizeOfArray(NavigateData.NamedValues)) to iCount
            For iIndex from 0 to (iCount - 1)
                If (NavigateData.NamedValues[iIndex].sName = "EquipoID") Begin
                    Move NavigateData.NamedValues[iIndex].sValue to sEquipoID
                End
            Loop

            If (sEquipoID <> "" and sEquipoID <> "0") Begin
                WebSet psEquipoID to sEquipoID
                Clear equipo
                Move (Integer(sEquipoID)) to equipo.ID
                Send Find of oequipo_DD EQ 1
                Set Field_Changed_Value of ojugador_DD Field jugador.EquipoID to (Integer(sEquipoID))
            End
        End
        Else Begin
            If (NavigateData.sRowId <> "") Begin
                Move (DeserializeRowID(NavigateData.sRowId)) to riJugador
                If (not(IsNullRowID(riJugador))) Begin
                    Send FindByRowId of ojugador_DD jugador.File_Number riJugador
                End
            End

            If (not(HasRecord(ojugador_DD))) Begin
                Move (SizeOfArray(NavigateData.NamedValues)) to iCount
                For iIndex from 0 to (iCount - 1)
                    If (NavigateData.NamedValues[iIndex].sName = "JugadorID" or NavigateData.NamedValues[iIndex].sName = "ID") Begin
                        Move NavigateData.NamedValues[iIndex].sValue to sJugadorID
                    End
                Loop

                If (sJugadorID <> "" and sJugadorID <> "0") Begin
                    Clear jugador
                    Move (Integer(sJugadorID)) to jugador.ID
                    Send Find of ojugador_DD EQ 1
                End
            End
        End

        Send SetActionButtons
    End_Procedure

    Procedure OnShow
        Forward Send OnShow
        Send SetActionButtons
    End_Procedure

End_Object